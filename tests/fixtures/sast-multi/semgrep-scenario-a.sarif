{
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "Semgrep OSS",
     "semanticVersion": "1.186.0",
     "rules": [
      {
       "defaultConfiguration": {
        "level": "note"
       },
       "id": "dockerfile.audit.dockerfile-source-not-pinned",
       "name": "dockerfile.audit.dockerfile-source-not-pinned",
       "properties": {
        "precision": "very-high",
        "tags": []
       },
       "shortDescription": {
        "text": "Semgrep Finding: dockerfile.audit.dockerfile-source-not-pinned"
       }
      },
      {
       "defaultConfiguration": {
        "level": "note"
       },
       "id": "javascript.express.security.audit.express-check-csurf-middleware-usage",
       "name": "javascript.express.security.audit.express-check-csurf-middleware-usage",
       "properties": {
        "precision": "very-high",
        "tags": [
         "CWE-352: Cross-Site Request Forgery (CSRF)",
         "LOW CONFIDENCE",
         "OWASP-A01:2021 - Broken Access Control",
         "OWASP-A01:2025 - Broken Access Control",
         "security"
        ]
       },
       "shortDescription": {
        "text": "Semgrep Finding: javascript.express.security.audit.express-check-csurf-middleware-usage"
       }
      },
      {
       "defaultConfiguration": {
        "level": "error"
       },
       "id": "javascript.express.security.injection.tainted-sql-string",
       "name": "javascript.express.security.injection.tainted-sql-string",
       "properties": {
        "precision": "very-high",
        "tags": [
         "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')",
         "LOW CONFIDENCE",
         "OWASP-A01:2017 - Injection",
         "OWASP-A03:2021 - Injection",
         "OWASP-A05:2025 - Injection",
         "security"
        ]
       },
       "shortDescription": {
        "text": "Semgrep Finding: javascript.express.security.injection.tainted-sql-string"
       }
      },
      {
       "defaultConfiguration": {
        "level": "note"
       },
       "id": "javascript.lang.correctness.useless-assignment",
       "name": "javascript.lang.correctness.useless-assignment",
       "properties": {
        "precision": "very-high",
        "tags": []
       },
       "shortDescription": {
        "text": "Semgrep Finding: javascript.lang.correctness.useless-assignment"
       }
      },
      {
       "defaultConfiguration": {
        "level": "warning"
       },
       "id": "yaml.github-actions.security.github-actions-mutable-action-tag",
       "name": "yaml.github-actions.security.github-actions-mutable-action-tag",
       "properties": {
        "precision": "very-high",
        "tags": [
         "CWE-1357: Reliance on Insufficiently Trustworthy Component",
         "CWE-353: Missing Support for Integrity Check",
         "HIGH CONFIDENCE",
         "OWASP-A08:2021 - Software and Data Integrity Failures",
         "OWASP-A08:2025 - Software and Data Integrity Failures",
         "security"
        ]
       },
       "shortDescription": {
        "text": "Semgrep Finding: yaml.github-actions.security.github-actions-mutable-action-tag"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "yaml.github-actions.security.github-actions-mutable-action-tag",
     "message": {
      "text": "GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-gi"
     },
     "properties": {},
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/appsec-pipeline.yml",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "endColumn": 34,
         "endLine": 26,
         "startColumn": 9,
         "startLine": 26
        }
       }
      }
     ]
    },
    {
     "ruleId": "yaml.github-actions.security.github-actions-mutable-action-tag",
     "message": {
