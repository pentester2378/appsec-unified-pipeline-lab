    },
    {
     "ruleId": "javascript.express.security.audit.express-check-csurf-middleware-usage",
     "message": {
      "text": "A CSRF middleware was not detected in your express application. Ensure you are either using one such as `csurf` or `csrf` (see rule references) and/or you are properly doing CSRF validation in your ro"
