    {
     "ruleId": "dockerfile.audit.dockerfile-source-not-pinned",
     "message": {
      "text": "To ensure reproducible builds, pin Dockerfile `FROM` commands to a specific hash. You can find the hash by running `docker pull node` and then  specify it with `node:22-alpine@sha256:<hash goes here>`"
     },
     "properties": {},
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "Dockerfile",
         "uriBaseId": "%SRCROOT%"
