         "startColumn": 7,
         "startLine": 7
        }
       }
      }
     ]
    },
    {
     "ruleId": "javascript.express.security.injection.tainted-sql-string",
     "message": {
      "text": "Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injectio"
     },
     "properties": {},
     "locations": [
